# Copy to .env (never commit .env). Every key is optional.
# Without any key the agent still runs: it finds pages with the IDE's own web search, saves
# each with `bin/strat read` (no key needed), and makes every judgment with the IDE's own model.

# --- Web search (strat search). One key is enough. Without any: strat search exits 2
# and the agent uses the IDE's own web search tool if it has one.
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# --- AnyModel: one key for two outside models (https://anymodel.org).
# The challenger, a peer model from another vendor (strat consult, strat debate, model
# respondents), and the judge that checks whether a quote supports a claim (strat judge).
# Empty STRAT_PEER_MODEL: consult.model in config/routes.yaml. Without the key the challenger
# runs as a native subagent of the IDE, marked same-vendor, and the IDE agent judges itself.
ANYMODEL_BASE_URL=https://anymodel.org/v1
ANYMODEL_API_KEY=
STRAT_PEER_MODEL=
STRAT_JEV_MODEL=jev/jev-1.14.0

# --- Speech to text for audio and video (strat media).
# Mistral (about 0.21 USD per hour of audio). Empty key means local Whisper
# (pip install faster-whisper); video and long audio need ffmpeg.
STRAT_STT_BASE_URL=https://api.mistral.ai/v1
STRAT_STT_API_KEY=
STRAT_STT_MODEL=voxtral-mini-transcribe-3-0
