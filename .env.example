# Copy to .env (never commit .env). Every key is optional.
# Without any key the agent still runs: local materials, pages you give it by URL,
# the IDE's own web search, and the IDE's own model for every judgment.

# --- Web search (strat search). One key is enough. Without any: strat search exits 2
# and the agent uses the IDE's own web search tool if it has one.
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# --- Challenger: a peer model from another vendor (Phase 2, strat consult).
# Without it the challenger runs as a native subagent of the IDE, marked same-vendor.
STRAT_PEER_BASE_URL=https://anymodel.org/v1
STRAT_PEER_API_KEY=
STRAT_PEER_MODEL=

# --- Small judgments: claim type, support, contradiction (Phase 2, strat judge).
# Without it judgments go to the peer model; without both, the IDE agent answers itself.
STRAT_JEV_BASE_URL=https://anymodel.org/v1
STRAT_JEV_API_KEY=
STRAT_JEV_MODEL=jev/jev-1.14.0

# --- Speech to text for audio and video (Phase 2, strat media). Empty means local Whisper.
STRAT_STT_BASE_URL=
STRAT_STT_API_KEY=
STRAT_STT_MODEL=
