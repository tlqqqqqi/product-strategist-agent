{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/user-prompt"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bin/strat *)",
      "Bash(./bin/strat *)",
      "Read(cases/**)",
      "Edit(cases/**)",
      "Write(cases/**)"
    ],
    "deny": [
      "Edit(cases/.inbox.jsonl)",
      "Write(cases/.inbox.jsonl)",
      "Edit(cases/**/.seal.json)",
      "Write(cases/**/.seal.json)"
    ]
  }
}
