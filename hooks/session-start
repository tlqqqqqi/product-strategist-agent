#!/usr/bin/env python3
"""Session-start hook, one script for every environment.

Prints the bootstrap skill plus the output of `strat state`, wrapped in the format the
environment expects. Standard library only, no install needed, never fails the session.
"""

import io
import json
import os
import sys
from contextlib import redirect_stderr, redirect_stdout
from pathlib import Path

ROOT = Path(os.environ.get("CLAUDE_PROJECT_DIR") or Path(__file__).resolve().parents[1])


def state_text() -> str:
    sys.path.insert(0, str(ROOT))
    os.environ.setdefault("STRAT_ROOT", str(ROOT))
    buf = io.StringIO()
    try:
        from strat.cli import main

        with redirect_stdout(buf), redirect_stderr(buf):
            main(["state"])
    except Exception as exc:  # the hook must never break the session
        buf.write(f"(strat state failed: {exc}; run `bin/strat state`)")
    return buf.getvalue().strip()


def context() -> str:
    skill = ROOT / "skills" / "using-strategist" / "SKILL.md"
    bootstrap = skill.read_text(encoding="utf-8") if skill.is_file() else "(bootstrap skill missing)"
    return (
        "<strategist-bootstrap>\n"
        "You are in the strategist folder. Follow skills/using-strategist (below).\n\n"
        f"{bootstrap}\n"
        "</strategist-bootstrap>\n\n"
        "<strategist-state>\n"
        f"$ bin/strat state\n{state_text()}\n"
        "</strategist-state>"
    )


# Output key per environment. Claude Code, Qwen Code (and its fork GigaCode) and Gemini CLI read
# hookSpecificOutput.additionalContext; Cursor reads additional_context; Copilot CLI reads a
# top-level additionalContext. Emit exactly one key: Claude Code reads two without dedup.
NESTED = ("claude", "qwen", "gigacode", "gemini")


def detect() -> str:
    if os.environ.get("CURSOR_PLUGIN_ROOT") or os.environ.get("CURSOR_PROJECT_DIR"):
        return "cursor"
    if os.environ.get("COPILOT_CLI"):
        return "copilot"
    if os.environ.get("CLAUDE_PROJECT_DIR"):
        return "claude"
    return "text"


def requested_format(argv) -> str:
    """`--format <env>` from the adapter's hook config wins; otherwise detect by env vars."""
    if "--format" in argv:
        i = argv.index("--format")
        if i + 1 < len(argv):
            return argv[i + 1]
    return os.environ.get("STRAT_HOOK_FORMAT") or detect()


def main(argv=None) -> None:
    fmt = requested_format(sys.argv[1:] if argv is None else argv)
    text = context()
    if fmt == "cursor":
        out = {"additional_context": text}
    elif fmt == "copilot":
        out = {"additionalContext": text}
    elif fmt in NESTED:
        out = {"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": text}}
    else:
        print(text)
        return
    print(json.dumps(out, ensure_ascii=False))


if __name__ == "__main__":
    main()
